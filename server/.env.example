# Server Configuration
PORT=5002
NODE_ENV=development

# MongoDB Connection
# Example: mongodb://localhost:27017/collabdocs
# Or MongoDB Atlas: mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/collabdocs?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/collabdocs

# JWT Secret for signing authentication tokens
JWT_SECRET=your_super_secret_jwt_key_at_least_32_chars_long

# CORS Allowed Origins (comma separated)
CORS_ORIGIN=http://localhost:5173,http://localhost:3000
